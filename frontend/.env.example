# Chain the app targets: 11155111 (Sepolia) or 31337 (local Hardhat node)
VITE_CHAIN_ID=31337
# RPC used for all reads, so search and resolve work without a wallet
VITE_RPC_URL=http://127.0.0.1:8545
# Optional: overrides the address in src/generated/deployments.json
VITE_CONTRACT_ADDRESS=
# Optional: first block to scan for events (defaults to the deploy block in deployments.json)
VITE_DEPLOY_BLOCK=
# Set to 1 to start in read-only demo mode (same as adding ?demo=1 to the URL)
VITE_DEMO=0
